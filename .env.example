# --- Database ---
# Postgres connection string (Prisma). Use a pooled connection string in
# production (e.g. Supabase/Neon/RDS Proxy) and run `bun run db:migrate` to
# apply migrations, then `bun run db:seed` to load the catalog.
DATABASE_URL="postgresql://user:password@localhost:5432/deniqwears?schema=public"

# --- App ---
# Public base URL, used to build payment gateway callback/redirect URLs.
APP_URL="http://localhost:3000"

# --- Admin auth ---
# Random string (32+ chars) used to sign admin session JWTs. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# Used only by `bun run db:seed` to create the first admin account (hashed
# with bcrypt before being stored — the plaintext value is never persisted).
# Leave unset on subsequent seed runs; rotate the password via the database
# directly or a future admin-management flow instead of re-seeding.
ADMIN_SEED_EMAIL="admin@deniqwears.com"
ADMIN_SEED_PASSWORD=""

# --- Transactional email (order confirmations) ---
# Create a Resend account (resend.com) and verify your sending domain to get
# a real key. Without it, order confirmation emails are skipped (logged as a
# warning) rather than silently pretending to send.
RESEND_API_KEY=""
EMAIL_FROM="Deniqwears Concierge <concierge@deniqwears.com>"

# --- Payment providers ---
# Only the providers you configure are usable; an unconfigured provider fails
# checkout with a clear "temporarily unavailable" error instead of silently
# pretending to succeed. See src/mocks/README.md to exercise these flows in
# development without real credentials.
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_SECRET_HASH=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Development-only mocking (never set these in production) ---
# Mirrors /api/* routes in the browser via MSW so the storefront can be
# developed without DATABASE_URL configured.
NEXT_PUBLIC_API_MOCKING="disabled"
# Intercepts outbound Paystack/Flutterwave HTTP calls via MSW (msw/node) so
# the checkout/payment flow can be exercised without real gateway keys.
PAYMENT_MOCKING="disabled"
